{
  "name": "skytravel",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "bots"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm --workspace server run dev\" \"npm --workspace client run dev\"",
    "dev:bots": "npm --workspace bots run dev",
    "build": "npm --workspace server run build && npm --workspace client run build && npm --workspace bots run build",
    "lint": "eslint client/src server/src bots/src e2e",
    "lint:fix": "eslint --fix client/src server/src bots/src e2e",
    "typecheck": "npm --workspace client exec -- tsc -b && npm --workspace server exec -- tsc --noEmit && npm --workspace bots exec -- tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "npm --workspace server run test && npm --workspace client run test",
    "test:e2e": "npx playwright test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "ts-prune": "^0.10.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  },
  "overrides": {
    "tar": "7.5.11",
    "@mapbox/node-pre-gyp": {
      "tar": "7.5.11"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
