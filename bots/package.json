    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "grammy": "^1.36.3",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.21",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
