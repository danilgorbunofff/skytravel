// Prisma schema placeholder. We'll hook it up after you confirm DB credentials.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tour {
  id          Int      @id @default(autoincrement())
  destination String
  title       String
  price       Int
  startDate   DateTime
  endDate     DateTime
  transport   String
  image       String
  description String?  @db.Text
  photos      Json?
  i18n        Json?
  sortOrder   Int      @default(0)
  source      String   @default("manual")
  externalId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]

  @@index([source])
  @@index([source, externalId])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Lead {
  id               Int      @id @default(autoincrement())
  email            String
  destination      String?
  tourId           Int?
  marketingConsent Boolean  @default(false)
  gdprConsent      Boolean  @default(false)
  source           String?
  createdAt        DateTime @default(now())
  tour             Tour?    @relation(fields: [tourId], references: [id], onDelete: SetNull)

  @@index([marketingConsent])
  @@index([tourId])
}

model EmailCampaign {
  id             Int      @id @default(autoincrement())
  subject        String
  preheader      String?
  fromEmail      String?
  html           String
  segment        String
  recipientCount Int      @default(0)
  sentAt         DateTime?
  createdAt      DateTime @default(now())
}

model ProviderTour {
  id            Int      @id @default(autoincrement())
  externalId    String
  source        String
  regionKey     String
  destination   String
  title         String
  price         Int
  originalPrice Int      @default(0)
  startDate     DateTime
  endDate       DateTime
  transport     String
  image         String   @db.Text
  description   String?  @db.Text
  photos        Json?
  url           String   @db.Text
  stars         String   @default("")
  board         String   @default("")
  nights        Int?
  adults        Int?
  children      Int?
  roomType      String?
  currency      String?
  offersCount   Int?
  destinationId Int?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  stateId       Int?
  canonicalDestination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([source, regionKey])
  @@index([price])
  @@index([startDate])
  @@index([source, regionKey, price])
  @@index([source, destination(100)])
  @@index([destinationId])
  @@index([source, stateId])
  @@index([source, transport])
  @@index([source, board])
  @@index([source, startDate])
  @@index([source, stateId, price])
}

model Destination {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  czechName     String   @unique
  canonicalName String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mappings DestinationMapping[]
  providerTours ProviderTour[]

  @@index([slug])
  @@index([czechName])
}

model DestinationMapping {
  id            Int         @id @default(autoincrement())
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  providerId    String
  providerKey   String
  providerValue String
  providerLabel String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([providerId, providerKey, providerValue])
  @@index([destinationId])
  @@index([providerId, providerLabel])
}

model ProviderSync {
  id           Int      @id @default(autoincrement())
  providerId   String
  regionKey    String
  status       String   @default("idle")
  lastSyncAt   DateTime?
  itemCount    Int      @default(0)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([providerId, regionKey])
}

model ProviderRegion {
  id               Int      @id @default(autoincrement())
  providerId       String
  regionKey        String
  externalId       String
  parentExternalId String   @default("")
  name             String
  tourCount        Int      @default(0)
  meta             Json?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([providerId, regionKey])
  @@index([providerId])
}

model PriceAlert {
  id          Int       @id @default(autoincrement())
  email       String
  providerId  String
  externalId  String
  tourTitle   String
  priceMax    Float
  createdAt   DateTime  @default(now())
  triggered   Boolean   @default(false)
  triggeredAt DateTime?

  @@index([providerId, externalId])
  @@index([email])
}
