// Prisma schema for SkyTravel.
// Key decisions:
// - i18n stored as JSON (Tour.i18n) for flexibility; typed at application layer
// - ProviderTour uses composite indexes optimized for public search queries
// - All mutable models have @updatedAt for change tracking

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

model Tour {
  id          Int      @id @default(autoincrement())
  destination String   @db.VarChar(255)
  title       String   @db.VarChar(500)
  price       Int
  startDate   DateTime
  endDate     DateTime
  transport   String   @db.VarChar(100)
  image       String   @db.VarChar(1000)
  description String?  @db.Text
  photos      Json?
  i18n        Json?
  sortOrder   Int      @default(0)
  source      String   @default("manual") @db.VarChar(50)
  externalId  String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]

  @@index([source])
  @@index([source, externalId])
  @@index([sortOrder, createdAt])
  @@index([destination])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  login        String   @unique @db.VarChar(100)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
}

model Lead {
  id               Int      @id @default(autoincrement())
  email            String   @db.VarChar(255)
  destination      String?  @db.VarChar(500)
  tourId           Int?
  marketingConsent Boolean  @default(false)
  gdprConsent      Boolean  @default(false)
  hashedEmail      String?  @db.VarChar(64)
  source           String?  @default("web") @db.VarChar(50)
  createdAt        DateTime @default(now())
  tour             Tour?    @relation(fields: [tourId], references: [id], onDelete: SetNull)

  @@index([marketingConsent])
  @@index([tourId])
  @@index([createdAt])
  @@index([email])
}

model EmailCampaign {
  id             Int      @id @default(autoincrement())
  subject        String   @db.VarChar(500)
  preheader      String?  @db.VarChar(500)
  fromEmail      String?  @db.VarChar(255)
  html           String   @db.LongText
  segment        String   @db.VarChar(50)
  recipientCount Int      @default(0)
  sentAt         DateTime?
  createdAt      DateTime @default(now())
}

// FULLTEXT index `provider_tour_search_idx` on (title, description)
// added via manual migration server/prisma/migrations/manual_fulltext/migration.sql
model ProviderTour {
  id            Int      @id @default(autoincrement())
  externalId    String   @db.VarChar(255)
  source        String   @db.VarChar(50)
  regionKey     String   @db.VarChar(100)
  destination   String   @db.VarChar(255)
  title         String   @db.VarChar(500)
  price         Int
  originalPrice Int      @default(0)
  startDate     DateTime
  endDate       DateTime
  transport     String   @db.VarChar(100)
  image         String   @db.Text
  description   String?  @db.Text
  photos        Json?
  url           String   @db.Text
  stars         String   @default("") @db.VarChar(10)
  board         String   @default("") @db.VarChar(50)
  nights        Int?
  adults        Int?
  children      Int?
  roomType      String?  @db.VarChar(100)
  currency      String?  @db.VarChar(10)
  offersCount   Int?
  destinationId Int?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  stateId       Int?
  canonicalDestination Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([source, regionKey])
  @@index([source, regionKey, price])
  @@index([source, regionKey, startDate, price])
  @@index([source, destination(100)])
  @@index([source, stateId])
  @@index([source, stateId, price])
  @@index([source, transport])
  @@index([source, board])
  @@index([source, startDate])
  @@index([destinationId])
}

model Destination {
  id            Int      @id @default(autoincrement())
  slug          String   @unique @db.VarChar(150)
  czechName     String   @unique @db.VarChar(255)
  canonicalName String   @unique @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mappings      DestinationMapping[]
  providerTours ProviderTour[]
}

model DestinationMapping {
  id            Int         @id @default(autoincrement())
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  providerId    String      @db.VarChar(50)
  providerKey   String      @db.VarChar(100)
  providerValue String      @db.VarChar(255)
  providerLabel String      @db.VarChar(255)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([providerId, providerKey, providerValue])
  @@index([destinationId])
  @@index([providerId, providerLabel])
}

model ProviderSync {
  id           Int      @id @default(autoincrement())
  providerId   String   @db.VarChar(50)
  regionKey    String   @db.VarChar(100)
  status       String   @default("idle") @db.VarChar(20)
  lastSyncAt   DateTime?
  itemCount    Int      @default(0)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([providerId, regionKey])
}

model ProviderRegion {
  id               Int      @id @default(autoincrement())
  providerId       String   @db.VarChar(50)
  regionKey        String   @db.VarChar(100)
  externalId       String   @db.VarChar(100)
  parentExternalId String   @default("") @db.VarChar(100)
  name             String   @db.VarChar(255)
  tourCount        Int      @default(0)
  meta             Json?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@unique([providerId, regionKey])
  @@index([providerId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // TOUR_IMPORT, TOUR_DELETE, CAMPAIGN_SEND, LEAD_DELETE, SETTINGS_CHANGE
  target    String   // e.g., "Tour#123", "Lead#45"
  details   String?  @db.Text
  adminUser String?  // username or "system"
  ip        String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model PriceAlert {
  id          Int       @id @default(autoincrement())
  email       String    @db.VarChar(255)
  hashedEmail String?   @db.VarChar(64)
  providerId  String    @db.VarChar(50)
  externalId  String    @db.VarChar(255)
  tourTitle   String    @db.VarChar(500)
  priceMax    Float
  createdAt   DateTime  @default(now())
  triggered   Boolean   @default(false)
  triggeredAt DateTime?

  @@index([providerId, externalId])
  @@index([email])
  @@index([triggered])
}
