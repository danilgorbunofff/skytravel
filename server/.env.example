# ─── Server ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://user:password@localhost:3306/skytravel
SESSION_SECRET=change-me-in-production-min-32-chars
CLIENT_ORIGIN=http://localhost:5173

# ─── Admin ────────────────────────────────────────────────────────────
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-now  # Override in production with a strong random string

# ─── SMTP (optional — email features disabled if empty) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Providers ────────────────────────────────────────────────────────
ALEXANDRIA_API_URL=http://export.alexandria.cz/export
ALEXANDRIA_API_KEY=
ALEXANDRIA_COUNTRY=107

# ─── Cache warming (set to "false" to skip on startup) ────────────────
PROVIDERS_WARM_ON_STARTUP=true

# ─── Rate limiter ─────────────────────────────────────────────────────
# Disable the tour search rate limiter (set to true for development/testing)
DISABLE_RATE_LIMIT=false
