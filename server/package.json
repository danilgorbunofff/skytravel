{
  "name": "skytravel-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "npx prisma migrate deploy && node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 $(find src -name \"*.test.ts\")",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.5.0",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.9.0",
    "gray-matter": "^4.0.3",
    "helmet": "^8.2.0",
    "lru-cache": "^11.3.6",
    "marked": "^15.0.7",
    "mariadb": "^3.4.5",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.3",
    "p-limit": "^7.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.17.7",
    "@types/node": "^22.19.21",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^7.2.0",
    "nock": "^14.0.15",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-prune": "^0.10.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "tar": "7.5.11",
    "@mapbox/node-pre-gyp": {
      "tar": "7.5.11"
    }
  }
}
